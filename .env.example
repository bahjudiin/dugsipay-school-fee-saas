# ── Required ────────────────────────────────────────────────
# PostgreSQL connection string.
#   Local dev (Docker):   postgresql://postgres:postgres@127.0.0.1:5432/app_db
#   Hosted (Neon/Vercel): postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Hosted Postgres only ────────────────────────────────────
# Set to "true" when using Neon / Vercel Postgres / Supabase.
# DATABASE_SSL=false

# ── Sales contact (public, shown on pricing page) ──────────
# Digits only, international format without "+".
# NEXT_PUBLIC_SALES_WHATSAPP=252612345678

# ── Password-reset emails (auth) ────────────────────────────
# Option A (production): Resend — emails are sent automatically.
# RESEND_API_KEY=re_xxxx
# EMAIL_FROM="DugsiPAY <no-reply@yourdomain.com>"
# APP_URL=https://your-domain.com
#
# Option B (local dev only): show the reset link on screen.
# EMAIL_DEV_LINKS=true
